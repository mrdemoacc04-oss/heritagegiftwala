# Copy to .env for local work. On Render, set these in the service's Environment tab.

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Use Supabase → Connect → "Session pooler" (port 5432). Render can't reach the IPv6-only direct
# connection, and the "Transaction pooler" (port 6543) breaks migrations.
# Heritage Gift Wala's project is bykxrjyonlcqvjsiqfdq in Tokyo, so the host is aws-0-ap-northeast-1.pooler.supabase.com.
# URL-encode special characters in the password (an @ becomes %40).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set to false only for a local Postgres without TLS.
# DATABASE_SSL=false

# ── URLs ─────────────────────────────────────────────────────────────────────
# This service's public URL (the admin panel lives at <this>/app)
MEDUSA_BACKEND_URL=https://heritagegiftwala-backend.onrender.com
# Comma-separated origins, no trailing slash. Add every domain the storefront is served from.
STORE_CORS=https://heritagegiftwala.in,https://www.heritagegiftwala.in
ADMIN_CORS=https://heritagegiftwala-backend.onrender.com
AUTH_CORS=https://heritagegiftwala-backend.onrender.com,https://heritagegiftwala.in

# ── Secrets (Render generates these from render.yaml) ───────────────────────
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# ── Owner login, created on first boot if that email has no login yet ───────
# Quote the password if it contains # or spaces. Change it from the admin panel afterwards.
ADMIN_EMAIL=owner@heritagegiftwala.in
ADMIN_PASSWORD=

# ── First-time catalog setup ─────────────────────────────────────────────────
# Where the seeded product photos are served from (the storefront's /products folder).
STOREFRONT_URL=https://heritagegiftwala.in
# Optional tweaks for the very first setup (change later in the admin panel)
# STARTING_STOCK=10
# STANDARD_DELIVERY=79
# EXPRESS_DELIVERY=149
# FREE_DELIVERY_FROM=999

# ── Photo storage (Supabase Storage, S3-compatible) ─────────────────────────
# Photos uploaded in the admin panel are kept here. Without it they are lost on every deploy.
# Supabase → Storage → create a PUBLIC bucket (e.g. "products"), then Storage → S3 Connection → new access key.
# S3_BUCKET=products
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FILE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/products

# ── Optional: Redis (Render Key Value) for events/workflows across several instances ──
# REDIS_URL=
