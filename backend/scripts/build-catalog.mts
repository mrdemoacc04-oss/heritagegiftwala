/**
 * Regenerates src/scripts/data/catalog.ts from the storefront's built-in
 * catalog (storefront/src/data). Run `npm run catalog:build` after editing
 * the storefront data and before the first deploy.
 */
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { products } from "../../storefront/src/data/products.ts";
import { categories } from "../../storefront/src/data/categories.ts";

const here = path.dirname(fileURLToPath(import.meta.url));
const publicDir = path.join(here, "../../storefront/public");
const exists = (src?: string) => Boolean(src) && fs.existsSync(path.join(publicDir, src!));

const catalog = {
  categories: categories.map((c) => ({ handle: c.handle, name: c.title, description: c.blurb, tint: c.tint, cover: c.cover })),
  products: products.map((p) => ({
    handle: p.handle,
    title: p.title,
    subtitle: p.subtitle,
    description: p.description,
    price: p.price,
    categories: p.categories,
    // Storefront gallery order: cutout (thumbnail), studio shot, shelf photo. Missing files are skipped.
    images: [p.image, p.studio, p.shelf].filter((src): src is string => Boolean(src) && exists(src)),
    metadata: {
      tint: p.tint,
      ...(p.badge ? { badge: p.badge } : {}),
      recipients: p.recipients.join(","),
      occasions: p.occasions.join(","),
      details: p.details.join(" | "),
      rank: p.rank,
      ...(p.hidden ? { hidden: "true" } : {}),
    },
    managed: !p.hidden,
  })),
};

const out = path.join(here, "../src/scripts/data/catalog.ts");
fs.writeFileSync(
  out,
  `// Generated by scripts/build-catalog.mts. Do not edit by hand.\nexport const catalog = ${JSON.stringify(catalog, null, 2)} as const;\n`,
);
console.log(`Wrote ${catalog.products.length} products, ${catalog.categories.length} categories → ${path.relative(process.cwd(), out)}`);
