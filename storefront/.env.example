# ── Medusa (backend on Render, Postgres on Supabase) ─────────────────────────
# Leave these empty to run the storefront on the built-in catalog (preview mode).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# The India region (INR) created in Medusa admin → Settings → Regions
NEXT_PUBLIC_MEDUSA_REGION_ID=

# Public URL of this storefront (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://heritagegiftwala.in
