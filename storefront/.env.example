# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" (port 6543). Leave empty to run the built-in preview catalog.
DATABASE_URL=
# Optional: Supabase's CA certificate (PEM, newlines as \n) to fully verify the database connection.
# DATABASE_SSL_CA=

# ── Security ─────────────────────────────────────────────────────────────────
# 32+ random characters (run: openssl rand -hex 32). Used to hash visitor IPs for rate limiting.
APP_SECRET=

# ── Product photo uploads (Supabase Storage) ────────────────────────────────
# Project URL and the service_role key (Project Settings → API). The key is a SERVER secret: never prefix it NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=products

# ── Public URL of this storefront (canonical links, sitemap, OG tags) ───────
NEXT_PUBLIC_SITE_URL=https://heritagegiftwala.in

# ── Optional: email the owner when an order arrives (resend.com) ────────────
# RESEND_API_KEY=
# ORDER_ALERT_EMAIL=
# MAIL_FROM=Heritage Gift Wala <orders@yourdomain.in>
