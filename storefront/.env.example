# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" (port 6543). Leave empty to run the built-in preview catalog.
DATABASE_URL=
# The connection to Supabase is encrypted AND verified against Supabase's own root certificate, which is built in
# (src/lib/server/pg-config.ts). Normally you set nothing here.
# DATABASE_SSL_CA=          override the certificate (PEM, newlines as \n)
# DATABASE_SSL_VERIFY=false emergency switch only, e.g. if Supabase replaces its root before the app is updated

# ── Security ─────────────────────────────────────────────────────────────────
# 32+ random characters (run: openssl rand -hex 32). Hashes visitor IPs for rate limiting AND encrypts the
# owner's two-step secret, so keep it private, and do not change it later without re-doing two-step set-up.
APP_SECRET=

# Who may ever sign in to /admin: comma-separated emails. REQUIRED in production: if it is empty, NO ONE can sign in.
ADMIN_ALLOWED_EMAILS=
# Two-step sign-in (authenticator app) is compulsory in production unless this is set to "false".
# ADMIN_REQUIRE_2FA=true

# ── Product photo uploads (Supabase Storage) ────────────────────────────────
# Project URL and the service_role key (Project Settings → API). The key is a SERVER secret: never prefix it NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=products

# ── Optional bot check on the order form (Cloudflare Turnstile, free) ───────
# Both must be set to switch it on. Create a widget at dash.cloudflare.com → Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Public URL of this storefront (canonical links, sitemap, OG tags) ───────
NEXT_PUBLIC_SITE_URL=https://heritagegiftwala.in

# ── Email (resend.com): password-reset links, security alerts, new-order alerts ─
# Without RESEND_API_KEY the "forgot password" page is switched off (in production) and no emails are sent.
# RESEND_API_KEY=
# MAIL_FROM=Heritage Gift Wala <orders@yourdomain.in>   (must be a domain verified in Resend)
# ORDER_ALERT_EMAIL=owner@yourdomain.in
